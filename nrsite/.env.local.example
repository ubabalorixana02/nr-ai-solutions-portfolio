# Copy this file to .env.local (which is gitignored) and fill in real values.
# .env.local.example itself should stay committed as a template.

# From your Sanity dashboard (sanity.io/manage) — already pre-filled with
# the project you created ("The NR Journal").
NEXT_PUBLIC_SANITY_PROJECT_ID=2unp9b2z

# Confirm this under the "Datasets" tab in your Sanity project dashboard.
# "production" is Sanity's default name for a project's first dataset —
# change this if yours is named something else.
NEXT_PUBLIC_SANITY_DATASET=production

NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Only needed if your dataset is set to "Private" (check Project > API in
# the Sanity dashboard). Public datasets don't need a token to read from.
# If you do need one: sanity.io/manage > your project > API > Tokens >
# Add API token > Viewer permissions > paste the value here.
# SANITY_API_READ_TOKEN=

# --- Contact form (Google Forms) ---
# 1. Go to forms.google.com and create a new form matching your contact
#    fields (Name, Email, Company, Subject, Message).
# 2. In the form editor, click Settings (gear icon) > Responses > turn on
#    "Get email notifications for new responses" — this is what sends new
#    submissions straight to ubabalorixana02@gmail.com (whichever Google
#    account you created the form with), no extra setup needed.
# 3. Click Send > the "<>" (embed) tab > copy the src="..." URL from the
#    <iframe> code it gives you > paste it below.
NEXT_PUBLIC_GOOGLE_CONTACT_FORM_URL=

# --- Consultation booking (Google Calendar) ---
# 1. In Google Calendar, click Create > Appointment schedule.
# 2. Set your available hours/duration, and consider adding a custom
#    question or two (e.g. "What service are you after?" / "What's the
#    challenge?") — Calendar will collect that at booking time.
# 3. Once created, click "Share" (or open the schedule) to get its public
#    booking page link, and paste that URL below. Bookings + cancellations
#    sync straight to your Google Calendar and email
#    ubabalorixana02@gmail.com automatically — that's native Calendar
#    behavior, nothing extra to configure.
NEXT_PUBLIC_GOOGLE_CALENDAR_BOOKING_URL=

# --- Testimonial submissions ---
# Visitors can submit a review from the Testimonials section — it's saved
# to Sanity as "pending" and only appears on the site once you approve it
# in Studio (flip its Status field to "Approved"). This needs a token with
# WRITE access (different from SANITY_API_READ_TOKEN above, which is
# read-only and safe to be more casual with):
# sanity.io/manage > your project > API > Tokens > Add API token >
# "Editor" permissions (Create is the minimum needed) > paste it below.
# Keep this one truly secret — never commit it, never prefix it with
# NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# --- Maintenance mode ---
# Set to "true" to take the public site offline temporarily and show a
# maintenance page instead — useful while making bigger changes. /studio
# and all /api routes stay reachable either way. Leave unset (or "false")
# for normal operation.
# MAINTENANCE_MODE=true

